 struct bridge_thread_start {
     recomp_func_t fn;
     uint32_t ctx1, ctx2, stack_top;
+    uint32_t kthread;           /* its thread object; see bridge_new_kthread */
 };
 
+/* The thread object fs:[0x28] points to (KPCR.PrcbData.CurrentThread).
+ *
+ * Every thread used to share the one the loader built, so XAPI's
+ * GetCurrentThreadId -- [[fs:[0x28]] + 0x12C], ETHREAD.UniqueThread -- gave
+ * every thread the same answer, and PsCreateSystemThreadEx never wrote the
+ * ThreadId it was asked for. A title that asks "am I that worker?" before
+ * waiting for it could get yes on the wrong thread: Panzer Dragoon Orta,
+ * stopping a stream worker on the main thread, then waited for an event only
+ * the worker's own path would see set, and hung.
+ *
+ * Each thread now gets a copy of the main thread's object (so the fields the
+ * loader filled in, TlsData among them, read as before) with its own id. */
+#define KTHREAD_COPY_SIZE  0x200
+#define KTHREAD_UNIQUE_ID  0x12C
+static volatile LONG g_next_thread_id = 0x100;
+static RECOMP_TLS uint32_t g_spawn_kthread;     /* for the next bridge_spawn_thread */
+
+static uint32_t bridge_new_kthread(uint32_t *id_out)
+{
+    uint32_t from = BRIDGE_MEM32(XBOX_TIB_MAIN + 0x28);
+    uint32_t kt = xbox_HeapAlloc(KTHREAD_COPY_SIZE, 16);
+    uint32_t id = (uint32_t)InterlockedExchangeAdd(&g_next_thread_id, 4) + 4;
+
+    *id_out = id;
+    if (!kt)
+        return 0;
+    for (uint32_t o = 0; o < KTHREAD_COPY_SIZE; o += 4)
+        BRIDGE_MEM32(kt + o) = from ? BRIDGE_MEM32(from + o) : 0;
+    BRIDGE_MEM32(kt + KTHREAD_UNIQUE_ID) = id;
+    return kt;
+}
