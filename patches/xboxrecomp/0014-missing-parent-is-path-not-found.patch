+/* NT tells a missing file (STATUS_OBJECT_NAME_NOT_FOUND) from a missing
+ * directory on the way to it (STATUS_OBJECT_PATH_NOT_FOUND, which XAPI turns
+ * into ERROR_PATH_NOT_FOUND). */
+static NTSTATUS path_errno_to_status(int e, const char *path)
+{
+    char parent[MAX_PATH];
+    size_t n = strlen(path);
+    const char *slash;
+    struct stat st;
+
+    /* A directory asked for with a trailing slash ("Z:\st11\") is that
+     * directory, not something inside it: its parent is above it. Taken as
+     * the directory itself, a missing one read as a missing parent, and a
+     * title that evicts and recreates its cache folders (Orta, between
+     * episodes) took the PATH_NOT_FOUND for a broken disc. */
+    while (n > 1 && path[n - 1] == '/')
+        n--;
+    slash = NULL;
+    for (size_t i = n; n < sizeof parent && i-- > 0;)
+        if (path[i] == '/') {
+            slash = path + i;
+            break;
+        }
+    if (e == ENOENT && slash && slash != path) {
+        memcpy(parent, path, (size_t)(slash - path));
+        parent[slash - path] = '\0';
+        if (stat(parent, &st) != 0 || !S_ISDIR(st.st_mode))
+            return STATUS_OBJECT_PATH_NOT_FOUND;
+    }
+    return errno_to_status(e);
+}
+
