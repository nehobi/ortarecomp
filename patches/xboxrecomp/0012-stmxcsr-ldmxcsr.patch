+        # SSE control/status register. Kept as guest state, like the x87
+        # control word: MSVC's CRT saves it with stmxcsr and restores it
+        # later, so a dropped store hands back stack garbage. The host's
+        # own MXCSR is left alone (the lifted SSE arithmetic is plain C).
+        if m == "stmxcsr" and ops and ops[0].type == "mem":
+            return [f"MEM32({_fmt_mem(ops[0])}) = g_mxcsr; /* stmxcsr {insn.op_str} */"]
+        if m == "ldmxcsr" and ops and ops[0].type == "mem":
+            return [f"g_mxcsr = MEM32({_fmt_mem(ops[0])}); /* ldmxcsr {insn.op_str} */"]
