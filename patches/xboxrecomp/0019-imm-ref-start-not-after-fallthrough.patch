+    def _falls_through_to(self, addr: int) -> bool:
+        """Whether a decoded instruction ending at `addr` continues into it:
+        anything but a ret, an unconditional jmp, a call, int3 or padding
+        (nop, and MSVC's `lea esp, [esp]`-style and `mov edi, edi` fillers)."""
+        for back in range(1, 16):
