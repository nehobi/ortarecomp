+/* A thread the guest suspended while it waited here must not take the lock
+ * meanwhile: on the console it is not scheduled, so it does not own the
+ * section until it is resumed and runs. Under the guest CPU lock the
+ * suspension only holds it back when it comes to run guest code again, by
+ * which time the host section was its own -- and the threads waiting on
+ * that section, the one the suspender was waiting for among them, waited
+ * for good (Panzer Dragoon Orta: a CRI worker, at a new game). Taken for the
+ * first time while suspended, the section is given back until resumed. */
 VOID __stdcall xbox_RtlEnterCriticalSection(PRTL_CRITICAL_SECTION CriticalSection)
 {
     CRITICAL_SECTION* cs = xbox_cs_shadow(CriticalSection);
     if (!cs)
         return;
+    for (;;) {
+        enter_cs(CriticalSection, cs);
+#ifdef _WIN32
+        if (cs->RecursionCount == 1 && xbox_thread_suspend_pending()) {
+            InterlockedIncrement(&g_cs_leaves);
+            xbox_cs_clear_owner(cs);
+            LeaveCriticalSection(cs);
+            while (xbox_thread_suspend_pending())
+                Sleep(1);
+            continue;
+        }
+#endif
+        return;
+    }
+}
