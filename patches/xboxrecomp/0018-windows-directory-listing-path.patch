 /* Translate an Xbox OBJECT_ATTRIBUTES path to a Win32 wide path */
+/* The host path of each open directory handle, for NtQueryDirectoryFile, kept
+ * from the open rather than asked of the handle (GetFinalPathNameByHandleW can
+ * fail, depending on the volume). A listing that fails is logged. */
+#define MAX_DIR_PATHS 64
+static struct { HANDLE handle; WCHAR path[MAX_PATH]; } s_dir_paths[MAX_DIR_PATHS];
+static CRITICAL_SECTION s_dir_paths_cs;
+static INIT_ONCE s_dir_paths_once = INIT_ONCE_STATIC_INIT;
+
+static BOOL CALLBACK dir_paths_init(PINIT_ONCE once, PVOID param, PVOID *ctx)
+{
+    (void)once; (void)param; (void)ctx;
+    InitializeCriticalSection(&s_dir_paths_cs);
+    return TRUE;
+}
+
+static void dir_path_set(HANDLE handle, const WCHAR *path)
+{
+    InitOnceExecuteOnce(&s_dir_paths_once, dir_paths_init, NULL, NULL);
+    EnterCriticalSection(&s_dir_paths_cs);
+    for (int i = 0; i < MAX_DIR_PATHS; i++)
+        if (s_dir_paths[i].handle == handle || (path && !s_dir_paths[i].handle)) {
+            s_dir_paths[i].handle = path ? handle : NULL;
+            if (path)
+                wcsncpy_s(s_dir_paths[i].path, MAX_PATH, path, _TRUNCATE);
+            break;
+        }
+    LeaveCriticalSection(&s_dir_paths_cs);
+}
+
+static BOOL dir_path_get(HANDLE handle, WCHAR *out, DWORD n)
+{
+    BOOL found = FALSE;
+    InitOnceExecuteOnce(&s_dir_paths_once, dir_paths_init, NULL, NULL);
+    EnterCriticalSection(&s_dir_paths_cs);
+    for (int i = 0; i < MAX_DIR_PATHS; i++)
+        if (s_dir_paths[i].handle == handle) {
+            wcsncpy_s(out, n, s_dir_paths[i].path, _TRUNCATE);
+            found = TRUE;
+            break;
+        }
+    LeaveCriticalSection(&s_dir_paths_cs);
+    return found;
+}
+
