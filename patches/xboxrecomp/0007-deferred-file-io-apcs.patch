 /* Per-thread pending-APC ring. An APC is delivered on the thread that issued
- * the request, which is also the thread that waits, so thread-local is right. */
+ * the request, which is also the thread that waits, so thread-local is right.
+ *
+ * A completion APC runs at the issuing thread's next alertable wait, as on
+ * NT, not inside the read. Running it inline breaks code that marks a request
+ * busy, issues it, checks the request is still busy and only then waits for
+ * the APC: JSRF's CRI ADX file server does exactly that (issue, `busy == 1`
+ * check, SleepEx(0, TRUE), then "done"). With the APC already run, the check
+ * failed, the request was never marked done and the music stream stalled
+ * after its first read. */
+
 static void bridge_complete_file_io(uint32_t event_token, uint32_t apc_routine,
                                     uint32_t apc_context, uint32_t iostatus)
 {
@@ -3202,10 +3232,39 @@ static void bridge_complete_file_io(uint32_t event_token, uint32_t apc_routine,
         if (ev) SetEvent(ev);
     }
     if (apc_routine) {
-        deliver_one_apc(apc_routine, apc_context, iostatus);
+        if (t_apc_count == APC_RING) {
+            static int warned;
+            if (!warned++)
+                fprintf(stderr, "  [KERNEL] file I/O APC queue full; "
+                                "delivering inline\n");
+            deliver_one_apc(apc_routine, apc_context, iostatus);
+            return;
+        }
+        unsigned i = (t_apc_head + t_apc_count++) % APC_RING;
+        t_apc[i].routine = apc_routine;
+        t_apc[i].context = apc_context;
+        t_apc[i].iostatus = iostatus;
     }
 }
 
+/* Deliver this thread's queued APCs, as an alertable wait does before it
+ * blocks. Only those queued on entry: one that queues another read gets its
+ * completion at the next wait. Returns how many ran. */
+static unsigned bridge_deliver_queued_apcs(void)
+{
+    unsigned n = t_apc_count, done = 0;
+    while (done < n && t_apc_count) {
+        unsigned i = t_apc_head;
+        uint32_t r = t_apc[i].routine, c = t_apc[i].context, io = t_apc[i].iostatus;
+        t_apc_head = (t_apc_head + 1) % APC_RING;
+        t_apc_count--;
+        deliver_one_apc(r, c, io);
+        done++;
+    }
+    return done;
+}
