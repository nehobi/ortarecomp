+/* Suspension under the guest CPU lock (RECOMP_GUEST_LOCK=1).
+ *
+ * Only the thread holding the guest CPU runs guest code, so a thread another
+ * one suspends is never in the middle of guest code: it is in a kernel call
+ * or waiting for the CPU. A host SuspendThread would still stop it wherever
+ * it is on the host side -- holding the guest CPU on its way in, or a host
+ * lock a title's override stands in for its own -- and every guest thread
+ * then waits for it. Panzer Dragoon Orta's CRI middleware suspends and
+ * resumes its threads around every locked region and froze the attract
+ * movie on Windows this way. (POSIX never suspended other threads at all,
+ * see win32_compat.c.)
+ *
+ * So under the lock the suspension is counted here and takes effect where
+ * the thread would take the guest CPU again (guest_cpu_acquire): it waits
+ * there until resumed, as a suspended thread on the console simply is not
+ * scheduled. A thread suspending itself waits at once. Threads created
+ * suspended are still resumed on the host, through the host count. */
+#ifdef _WIN32
+#define MAX_COOP_SUSPEND 128
+static struct { DWORD tid; LONG count; } s_coop[MAX_COOP_SUSPEND];
+static SRWLOCK s_coop_lock = SRWLOCK_INIT;
+int xbox_guest_cpu_lock_on(void);
+
+static LONG *coop_count(DWORD tid, int create)
+{
+    int i, free_slot = -1;
+    for (i = 0; i < MAX_COOP_SUSPEND; i++) {
+        if (s_coop[i].tid == tid)
+            return &s_coop[i].count;
+        if (free_slot < 0 && (s_coop[i].tid == 0 || s_coop[i].count == 0))
+            free_slot = i;
+    }
+    if (!create || free_slot < 0)
+        return NULL;
+    s_coop[free_slot].tid = tid;
+    s_coop[free_slot].count = 0;
+    return &s_coop[free_slot].count;
+}
+
+int xbox_thread_suspend_pending(void)
+{
+    LONG *c;
+    int pending;
+    AcquireSRWLockShared(&s_coop_lock);
+    c = coop_count(GetCurrentThreadId(), 0);
+    pending = c && *c > 0;
+    ReleaseSRWLockShared(&s_coop_lock);
+    return pending;
+}
+#else
+int xbox_thread_suspend_pending(void)
+{
+    return 0;
+}
+#endif
+
