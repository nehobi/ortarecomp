+        LONG *c;
+        if (!tid)
+            return STATUS_UNSUCCESSFUL;
+        AcquireSRWLockExclusive(&s_coop_lock);
+        c = coop_count(tid, 1);
+        prev = c ? (DWORD)(*c)++ : 0;
+        ReleaseSRWLockExclusive(&s_coop_lock);
+        if (PreviousSuspendCount)
+            *PreviousSuspendCount = (ULONG)prev;
+        /* Suspending itself: wait now (this is a kernel call, the guest CPU
+         * is not held). */
+        if (tid == GetCurrentThreadId())
+            while (xbox_thread_suspend_pending())
+                Sleep(1);
+        return STATUS_SUCCESS;
+    }
+#endif
+
     /*
      * SuspendThread returns the previous suspend count, or (DWORD)-1 on
      * failure. The Xbox call reports that count through an out-parameter, so
@@ -378,6 +455,27 @@
