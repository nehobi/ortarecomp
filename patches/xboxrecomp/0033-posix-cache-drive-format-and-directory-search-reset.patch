+/* Formatting a cache partition empties the folder that stands in for it.
+ *
+ * The utility drive (Z:, \Device\Harddisk0\Partition3..5) is a FATX image to
+ * XAPI but a plain folder to the title: XAPI formats the image (writes a
+ * fresh FATX boot sector at offset 0) and every file the title then makes
+ * goes to <save>/Cache. The format never reached that folder, so whatever an
+ * earlier run cached was still there on a drive the title had just seen
+ * formatted. Panzer Dragoon Orta formats its cache at every boot, copies
+ * each stage file to <name>.tmp and renames it into place without
+ * ReplaceIfExists -- which can only fail on a stale file. From the second
+ * run on the renames failed (STATUS_OBJECT_NAME_COLLISION), and entering the
+ * tutorial or the next stage showed the "disc may be dirty" screen. */
+static int cache_clear_entry(const char *path, const struct stat *st, int type, struct FTW *ftw)
+{
+    (void)st;
+    if (ftw->level == 0)
+        return 0;   /* the folder itself stays */
+    if ((type == FTW_DP ? rmdir(path) : unlink(path)) != 0)
+        fprintf(stderr, "  [FILE] cache format: could not remove %s (errno %d)\n", path, errno);
+    return 0;
+}
+
+static void cache_partition_formatted(const char *image)
+{
+    char xbox_dir[] = "\\Device\\Harddisk0\\PartitionN\\";
+    char host_dir[MAX_PATH];
+    const char *base = image ? strrchr(image, '/') : NULL;
+
+    if (!base || strncmp(base, "/Partition", 10) != 0 || base[10] < '3' || base[10] > '5'
+            || strcmp(base + 11, ".img") != 0)
+        return;
+    xbox_dir[sizeof xbox_dir - 3] = base[10];
+    if (!xbox_translate_path(xbox_dir, host_dir, MAX_PATH))
+        return;
+    fprintf(stderr, "  [FILE] Partition%c formatted: emptying %s\n", base[10], host_dir);
+    fflush(stderr);
+    nftw(host_dir, cache_clear_entry, 16, FTW_DEPTH | FTW_PHYS);
+}
