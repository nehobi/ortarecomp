@@ -1268,6 +1312,30 @@
 static CRITICAL_SECTION s_dir_cs;
 static BOOL s_dir_cs_init = FALSE;
 
+/* A closed directory handle takes its enumeration with it, as on Windows.
+ * Here a handle is the address of its object, and the next object allocated
+ * often gets the same address: a search abandoned at its first match then
+ * carried on under the next directory opened. Panzer Dragoon Orta looks for
+ * each cache file by name before copying it to Z:; the second lookup got the
+ * old search's NO_MORE_FILES, the file was copied again and its rename
+ * collided with the copy already there -- the "disc may be dirty" screen on
+ * entering the tutorial or the next stage. */
+void xbox_dir_context_drop(HANDLE FileHandle)
+{
+    if (!s_dir_cs_init)
+        return;
+    EnterCriticalSection(&s_dir_cs);
+    for (int i = 0; i < MAX_DIR_CONTEXTS; i++) {
+        if (s_dir_contexts[i].handle == FileHandle) {
+            if (s_dir_contexts[i].dir)
+                closedir(s_dir_contexts[i].dir);
+            s_dir_contexts[i].dir = NULL;
+            s_dir_contexts[i].handle = NULL;
+        }
+    }
+    LeaveCriticalSection(&s_dir_cs);
+}
