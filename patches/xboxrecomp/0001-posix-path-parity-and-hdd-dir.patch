+/* Xbox file names are case-insensitive; most Linux filesystems are not.
+ * When a translated path does not exist as written, find each component
+ * ignoring case. The last component may legitimately not exist yet (a file
+ * being created); it is then kept as the title spelled it. */
+#include <dirent.h>
+static void xbox_resolve_case_posix(char *path, size_t size)
+{
+    struct stat st;
+    char out[MAX_PATH], comp[MAX_PATH];
+    const char *p;
+    size_t olen;
+
+    if (stat(path, &st) == 0 || path[0] != '/')
+        return;
+
+    out[0] = '\0';
+    olen = 0;
+    p = path;
+    while (*p) {
+        size_t clen;
+        const char *next;
+        DIR *d;
+        struct dirent *de;
+        BOOL found = FALSE;
+
+        while (*p == '/')
+            p++;
+        if (!*p)
+            break;
+        next = strchr(p, '/');
+        clen = next ? (size_t)(next - p) : strlen(p);
+        if (clen >= sizeof(comp))
+            return;
+        memcpy(comp, p, clen);
+        comp[clen] = '\0';
+
+        d = opendir(olen ? out : "/");
+        if (d) {
+            while ((de = readdir(d)) != NULL) {
+                if (strcasecmp(de->d_name, comp) == 0) {
+                    snprintf(comp, sizeof(comp), "%s", de->d_name);
+                    found = TRUE;
+                    break;
+                }
+            }
+            closedir(d);
+        }
+        /* "dir/" ends in a separator: its last component is "dir", which a
+         * directory create may be about to make. */
+        if (!found && next && next[strspn(next, "/")])
+            return;     /* a missing directory: leave the path alone */
+        if (olen + 1 + strlen(comp) + 1 > sizeof(out))
+            return;
+        out[olen++] = '/';
+        strcpy(out + olen, comp);
+        olen += strlen(comp);
+        p = next ? next : p + clen;
+    }
+    if (olen && olen < size)
+        memcpy(path, out, olen + 1);
+}
