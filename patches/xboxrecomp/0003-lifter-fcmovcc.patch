@@ -0,0 +1,72 @@
+"""FCMOVcc: a conditional move between x87 registers on an EFLAGS condition.
+
+It used to be dropped (lifted to a comment), so the move never happened. The
+MSVC CRT's fmin/fmax are built on it, and both then returned their second
+argument whatever the inputs.
+"""
+import unittest
+
+from .disasm import BasicBlock, Instruction, Operand
+from .lifter import Lifter, lift_basic_block
+
+
+def _insn(mnemonic, op_str, operands):
+    insn = Instruction(0, 2, mnemonic, op_str, "")
+    insn.operands = operands
+    return insn
+
+
+def _crt_minmax(fcmov):
+    # fld [esp+4]; fld [esp+8]; fcom st(1); xor eax, eax; fnstsw ax;
+    # test ah, 1; fcmov st(0), st(1); fxch st(1); fstp st(0)
+    def arg(disp):
+        return Operand(type="mem", mem_base="esp", mem_disp=disp, mem_size=4)
+    st = [Operand(type="reg", reg="st(0)"), Operand(type="reg", reg="st(1)")]
+    insns = [
+        _insn("fld", "dword ptr [esp + 4]", [arg(4)]),
+        _insn("fld", "dword ptr [esp + 8]", [arg(8)]),
+        _insn("fcom", "st(1)", [st[1]]),
+        _insn("xor", "eax, eax", [Operand(type="reg", reg="eax"),
+                                  Operand(type="reg", reg="eax")]),
+        _insn("fnstsw", "ax", [Operand(type="reg", reg="ax")]),
+        _insn("test", "ah, 1", [Operand(type="reg", reg="ah"),
+                                Operand(type="imm", imm=1)]),
+        _insn(fcmov, "st(0), st(1)", st),
+        _insn("fxch", "st(1)", st),
+        _insn("fstp", "st(0)", [st[0]]),
+    ]
+    lifted, _ = lift_basic_block(
+        Lifter(), BasicBlock(start=0, instructions=insns))
+    return "\n".join(lifted)
+
+
+class FcmovLiftTest(unittest.TestCase):
+    def test_fcmove_moves_when_zf_is_set(self):
+        generated = _crt_minmax("fcmove")
+        self.assertNotIn("/* FPU: fcmove", generated)
+        line = next(l for l in generated.splitlines() if "fcmove" in l)
+        self.assertIn("fp_top() = fp_st1();", line)
+        # ZF after `test ah, 1` is "C0 clear", i.e. the zero-result test.
+        self.assertTrue(line.startswith("if (TEST_Z("), line)
+
+    def test_fcmovne_moves_when_zf_is_clear(self):
+        generated = _crt_minmax("fcmovne")
+        line = next(l for l in generated.splitlines() if "fcmovne" in l)
+        self.assertIn("fp_top() = fp_st1();", line)
+        self.assertTrue(line.startswith("if (TEST_NZ("), line)
+
+    def test_fcmov_reads_the_named_register(self):
+        st = [Operand(type="reg", reg="st(0)"), Operand(type="reg", reg="st(3)")]
+        insns = [
+            _insn("test", "ah, 1", [Operand(type="reg", reg="ah"),
+                                    Operand(type="imm", imm=1)]),
+            _insn("fcmovb", "st(0), st(3)", st),
+        ]
+        lifted, _ = lift_basic_block(
+            Lifter(), BasicBlock(start=0, instructions=insns))
+        self.assertIn("fp_top() = g_fp_stack[(g_fp_top + 3) & 7];",
+                      "\n".join(lifted))
+
+
+if __name__ == "__main__":
+    unittest.main()
