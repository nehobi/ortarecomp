index cd1dcb4..4a65807 100644
--- a/tools/recomp/test_lifter_atomics.py
+++ b/tools/recomp/test_lifter_atomics.py
@@ -55,3 +55,43 @@ class AtomicLiftTest(unittest.TestCase):
                 generated = _lift(m, "edx")
                 self.assertNotIn("TODO", generated)
                 self.assertIn("RECOMP_ATOMIC_", generated)
+
+
+def _lift_with_branch(mnemonic, jcc):
+    """`lock xadd [ecx], edx` followed by a conditional jump on its flags."""
+    insn = Instruction(0, 4, mnemonic, "dword ptr [ecx], edx", "f00fc111")
+    insn.operands = [_mem_ecx(), Operand(type="reg", reg="edx")]
+    jump = Instruction(4, 2, jcc, "0x10", "750a")
+    jump.jump_target = 0x10
+    lifter = Lifter()
+    lifter.func_start = 0
+    lifter.func_end = 0x20
+    lifted, _ = lift_basic_block(
+        lifter, BasicBlock(start=0, instructions=[insn, jump]))
+    return chr(10).join(lifted)
+
+
+class XaddFlagsTest(unittest.TestCase):
+    """InterlockedDecrement inlined: `or edx,-1; lock xadd [ecx],edx; jne`.
+
+    That is how a COM Release decides whether the object is still referenced.
+    The locked form used to be treated as leaving the flags undefined, so the
+    jne read the fallback flag variable, never jumped, and every Release freed
+    its object -- a double free on the second Release.
+    """
+
+    def test_locked_xadd_snapshots_the_sum(self):
+        generated = _lift_with_branch("lock xadd", "jne")
+        self.assertIn("_fa = _old + _src;", generated)
+
+    def test_jne_after_locked_xadd_tests_the_sum(self):
+        for m in ("xadd", "lock xadd"):
+            with self.subTest(mnemonic=m):
+                generated = _lift_with_branch(m, "jne")
+                self.assertIn("(_fa != 0)", generated)
+                self.assertNotIn("_flags /*", generated)
+
+    def test_je_and_sign_branches_after_locked_xadd(self):
+        self.assertIn("(_fa == 0)", _lift_with_branch("lock xadd", "je"))
+        self.assertIn("(_fas < 0)", _lift_with_branch("lock xadd", "js"))
+        self.assertIn("(_fas >= 0)", _lift_with_branch("lock xadd", "jns"))
