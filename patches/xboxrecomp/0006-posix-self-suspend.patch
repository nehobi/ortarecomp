diff --git a/src/platform/win32_compat.c b/src/platform/win32_compat.c
index 93288d5..ae0895e 100644
--- a/src/platform/win32_compat.c
+++ b/src/platform/win32_compat.c
@@ -786,13 +786,21 @@ DWORD ResumeThread(HANDLE h)
 
 DWORD SuspendThread(HANDLE h)
 {
-    /* True mid-run suspension is not supported on POSIX; only the
-     * CREATE_SUSPENDED start gate is. Track the count for ResumeThread. */
-    w32_object *o = (w32_object *)h;
+    /* Suspending another thread mid-run is not supported on POSIX: only the
+     * count is tracked for it. A thread suspending *itself* is, and must be:
+     * worker threads that run once per wake-up and then suspend themselves
+     * (JSRF's CRI ADX decoder, XAPI's own worker) otherwise spin flat out
+     * instead of waiting for the next ResumeThread. Its wait is the same gate
+     * the CREATE_SUSPENDED start uses; the count is checked under the lock,
+     * so a resume that comes first is not lost. */
+    w32_object *o = (h == PSEUDO_CURRENT_THREAD) ? t_self_obj : (w32_object *)h;
     if (!o || o->kind != K_THREAD) return (DWORD)-1;
     pthread_mutex_lock(&o->lock);
     DWORD prev = (DWORD)o->suspend_count;
     o->suspend_count++;
+    if (o == t_self_obj)
+        while (o->suspend_count > 0)
+            pthread_cond_wait(&o->gate, &o->lock);
     pthread_mutex_unlock(&o->lock);
     return prev;
 }
