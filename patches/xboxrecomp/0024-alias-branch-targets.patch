+    def _close_alias_branches(self, bodies, body_starts) -> None:
+        """
+        Give an entry to every branch out of a body that lands inside another.
+
+        An alias is lifted as its own body, from its entry to the end of the
+        function it sits in, so a branch to before that entry leaves the body
+        -- and the commonest such branch is the back-edge of the loop the
+        entry was jumped into. With no function there, the branch is lifted
+        as a call to a stub that pops a return address and returns: the loop
+        runs once, and the function returns with esp four bytes off and its
+        epilogue skipped. Panzer Dragoon Orta had 224 of these, from aliases
+        such as 0x000B7082 whose loop head 0x000B7050 lies in the enclosing
+        sub_000B6EA0 just before it.
+
+        The cure is the same alias mechanism, applied to its own output until
+        nothing new turns up: the branch target becomes an alias running to
+        the end of the body it lands in. Ordinary functions are scanned too,
+        since a conditional branch out of a body into another's interior is
+        the same stub call (the pass above it excludes jcc). Aliases do not
+        clamp anyone's end, so no boundary moves.
+        """
+        def interior(t):
+            j = bisect.bisect_right(body_starts, t) - 1
+            if j >= 0 and bodies[j][0] < t < bodies[j][1]:
+                return bodies[j][1]
+            return None
+
+        work = [(f.start, f.end) for f in self.functions.values()
+                if f.start not in self._alias_entries]
+        for addr, end in self._alias_entries.items():
+            if interior(addr) is not None:
+                work.append((addr, end))    # a gap alias's end is not known yet
+        added = 0
+        while work:
+            addr, end = work.pop()
+            for insn in self.engine.get_instructions_in_range(addr, end):
+                if not insn.is_branch:
+                    continue
+                t = insn.jump_target
+                if t is None or addr <= t < end:
+                    continue
+                if (t in self._alias_entries or t in self.functions
+                        or t in self._candidates
+                        or t not in self.engine.instructions):
+                    continue
+                t_end = interior(t)
+                if t_end is None:
+                    continue
+                self._alias_entries[t] = t_end
+                work.append((t, t_end))
+                added += 1
+        if added:
+            print(f"  {added} branch target(s) out of a body made alias entries")
+
