+/* Hands [native, native + size) back from the guest-space reservation, so a
+ * fixed mapping can take its place. No-op outside it (Windows, or no
+ * reservation). */
+static void span_release(uintptr_t native, size_t size)
+{
+    uintptr_t lo = (uintptr_t)g_span_base;
+
+    if (g_span_base && native >= lo && native + size <= lo + g_span_size)
+        VirtualFree((LPVOID)native, size, MEM_RELEASE);
+}
