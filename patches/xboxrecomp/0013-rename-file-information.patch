 /* ======================================================================== */
+/* Rename an open file (NtSetInformationFile, FileRenameInformation).
+ *
+ * Titles that cache disc files on the hard disk write a temporary copy and
+ * rename it into place once it is complete; Panzer Dragoon Orta copies to
+ * Z:\\<name>.tmp and renames. Unhandled, the rename failed, the cache never
+ * held the file, and the title copied it again on every load -- over and
+ * over for a file in a cache subfolder, which kept it in its loader. */
+NTSTATUS xbox_RenameFile(HANDLE FileHandle, PXBOX_OBJECT_ATTRIBUTES NewName, BOOLEAN ReplaceIfExists)
+{
+    WCHAR to[MAX_PATH];
+    BYTE buf[sizeof(FILE_RENAME_INFO) + MAX_PATH * sizeof(WCHAR)];
+    FILE_RENAME_INFO *ri = (FILE_RENAME_INFO *)buf;
+    size_t n;
+
+    if (!translate_obj_path(NewName, to, MAX_PATH))
+        return STATUS_OBJECT_PATH_NOT_FOUND;
+    n = wcslen(to);
+    memset(buf, 0, sizeof(buf));
+    ri->ReplaceIfExists = ReplaceIfExists ? TRUE : FALSE;
+    ri->FileNameLength = (DWORD)(n * sizeof(WCHAR));
+    memcpy(ri->FileName, to, (n + 1) * sizeof(WCHAR));
+    if (SetFileInformationByHandle(FileHandle, FileRenameInfo, ri, (DWORD)sizeof(buf)))
+        return STATUS_SUCCESS;
+    {   /* A handle opened without DELETE access cannot rename itself. */
+        WCHAR from[MAX_PATH];
+        DWORD used = GetFinalPathNameByHandleW(FileHandle, from, MAX_PATH,
+                                               FILE_NAME_NORMALIZED | VOLUME_NAME_DOS);
+        if (used && used < MAX_PATH &&
+            MoveFileExW(from, to, ReplaceIfExists ? MOVEFILE_REPLACE_EXISTING : 0))
+            return STATUS_SUCCESS;
+    }
+    return GetLastError() == ERROR_ALREADY_EXISTS || GetLastError() == ERROR_FILE_EXISTS
+         ? (NTSTATUS)0xC0000035L      /* STATUS_OBJECT_NAME_COLLISION */
+         : STATUS_UNSUCCESSFUL;
+}
+
 #else /* !_WIN32 */
 /* ====================  POSIX backend  =================================== */
 /* ======================================================================== */
@@ -1251,6 +1287,31 @@ NTSTATUS __stdcall xbox_NtQueryDirectoryFile(
     return STATUS_SUCCESS;
 }
 
+/* Rename an open file; see the _WIN32 version above for why. */
+NTSTATUS xbox_RenameFile(HANDLE FileHandle, PXBOX_OBJECT_ATTRIBUTES NewName, BOOLEAN ReplaceIfExists)
+{
+    char to[MAX_PATH];
+    const char *from = w32_handle_path(FileHandle);
+    const char *xbox_path = get_xbox_path(NewName);
+    struct stat st;
+
+    if (!from || !xbox_path)
+        return STATUS_INVALID_PARAMETER;
+    if (NewName->RootDirectory && xbox_path[0] != '\\' && !(xbox_path[0] && xbox_path[1] == ':')) {
+        const char *dir = w32_handle_path(NewName->RootDirectory);
+        if (!dir || (size_t)snprintf(to, sizeof to, "%s/%s", dir, xbox_path) >= sizeof to)
+            return STATUS_OBJECT_PATH_NOT_FOUND;
+    } else if (!xbox_translate_path(xbox_path, to, MAX_PATH)) {
+        return STATUS_OBJECT_PATH_NOT_FOUND;
+    }
+    if (!ReplaceIfExists && stat(to, &st) == 0)
+        return (NTSTATUS)0xC0000035L;   /* STATUS_OBJECT_NAME_COLLISION */
+    if (rename(from, to) != 0)
+        return errno_to_status(errno);
+    w32_set_handle_path(FileHandle, to);
+    return STATUS_SUCCESS;
+}
+
 #endif /* _WIN32 */
 
